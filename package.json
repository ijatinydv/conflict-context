{
  "name": "conflict-context",
  "version": "0.1.0",
  "description": "AI-assisted git conflict resolver that reconstructs why each side changed before proposing a merge.",
  "type": "module",
  "bin": {
    "conflict-context": "./dist/cli/index.js",
    "cctx": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "git",
    "merge",
    "conflict",
    "rebase",
    "merge-conflict",
    "ai",
    "llm",
    "cli",
    "devtools"
  ],
  "license": "MIT",
  "author": "ijatinydv",
  "homepage": "https://github.com/ijatinydv/conflict-resolver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ijatinydv/conflict-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/ijatinydv/conflict-resolver/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "execa": "^9.4.0",
    "ora": "^8.1.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.7.0",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.1"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
